<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the manager's pure logic, needing no device: settings and library
    persistence, playlist order, process arguments, the theme, interop sizes.
    Built with the solution; tools/release.ps1 runs them with `dotnet test` on
    the built assembly.

    Output goes to test-out\, never x64\Release: that folder is the release drop.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DebugType>none</DebugType>

    <OutputPath>$(SolutionDir)test-out\managed\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JLDisplayManager\JLDisplayManager.csproj" />
  </ItemGroup>

</Project>
