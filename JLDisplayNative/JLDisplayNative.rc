// JLDisplayNative resources: version
#include <winres.h>
#include "jl_version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    JL_VERSION_RC
 PRODUCTVERSION JL_VERSION_RC
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      JL_COMPANY
            VALUE "FileDescription",  "Jungle Leopard Display native engine"
            VALUE "FileVersion",      JL_VERSION_STRING
            VALUE "InternalName",     "JLDisplayNative"
            VALUE "LegalCopyright",   JL_COPYRIGHT
            VALUE "OriginalFilename", "JLDisplayNative.dll"
            VALUE "ProductName",      JL_PRODUCT
            VALUE "ProductVersion",   JL_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
