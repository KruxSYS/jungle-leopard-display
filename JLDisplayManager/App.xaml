<Application x:Class="JLDisplayManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:JLDisplayManager.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Every colour, radius, border and control template lives in the
                 theme. Nothing below this line, and nothing in any view, writes
                 a colour down: see Themes/KruxSYS.xaml and docs/brand.md. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/KruxSYS.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <v:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <v:BoolToVisibilityConverter x:Key="BoolToVisibilityInverse" Invert="True"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
