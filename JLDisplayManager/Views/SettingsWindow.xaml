<Window x:Class="JLDisplayManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="640" Width="470"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="PICTURE" Style="{StaticResource Heading}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rotation" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <ComboBox x:Name="RotateBox" Grid.Column="1">
                        <ComboBoxItem><TextBlock Text="0° — as mounted" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="90° clockwise" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="180° — upside down" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="270° clockwise" Foreground="#1A1207"/></ComboBoxItem>
                    </ComboBox>
                </Grid>

                <CheckBox x:Name="StretchBox"
                          Content="Stretch to fill (ignore the source's aspect ratio)"/>
                <TextBlock Margin="24,0,0,10" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Off pads with black to keep the picture's shape."/>

                <Grid Margin="0,4,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Frame rate" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <!-- IsMoveToPointEnabled, because a Slider's default answer
                         to a click on the track is to step by LargeChange (one
                         tick) rather than to go where it was clicked. Over a
                         range of 1 to 60 that reads as the control ignoring you:
                         clicking at 5 while sitting at 30 moves to 29. -->
                    <Slider x:Name="FpsSlider" Grid.Column="1" Minimum="1" Maximum="60"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="OnFpsChanged"/>
                    <TextBlock x:Name="FpsValue" Grid.Column="2" TextAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Margin="0,-6,0,14" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="The panel refreshes at 30 fps; asking for more mostly wastes CPU."/>

                <TextBlock Text="DECODING" Style="{StaticResource Heading}"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Acceleration" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <ComboBox x:Name="HwaccelBox" Grid.Column="1">
                        <ComboBoxItem><TextBlock Text="auto" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="none (software)" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="cuda" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="qsv" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="d3d11va" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="dxva2" Foreground="#1A1207"/></ComboBoxItem>
                    </ComboBox>
                </Grid>
                <TextBlock Margin="0,0,0,14" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Affects decoding only — the JPEG encode always runs on the CPU. Helps most on high-resolution sources."/>

                <TextBlock Text="PREPROCESSING" Style="{StaticResource Heading}"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Mode" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <ComboBox x:Name="PreprocessBox" Grid.Column="1"
                              SelectionChanged="OnPreprocessChanged">
                        <ComboBoxItem><TextBlock Text="Off — transcode while playing" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="Memory — transcode once into RAM" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="Disk — transcode once, keep on disk" Foreground="#1A1207"/></ComboBoxItem>
                    </ComboBox>
                </Grid>

                <Grid x:Name="BudgetRow" Margin="0,6,0,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BudgetLabel" Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <ComboBox x:Name="BudgetBox" Grid.Column="1"
                              SelectionChanged="OnBudgetChanged"/>
                </Grid>

                <CheckBox x:Name="PerFrameBox" Margin="0,8,0,2"
                          Content="Give every frame the best quality it fits"
                          Click="OnPerFrameChanged"
                          ToolTip="Off, a video is encoded at the one setting its busiest frame allows, and every simpler frame is worse than it needed to be. On, each frame is encoded at its own. Preprocessed frames only."/>

                <Grid x:Name="ByteRateRow" Margin="0,4,0,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Data rate" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <ComboBox x:Name="ByteRateBox" Grid.Column="1"
                              SelectionChanged="OnByteRateChanged"
                              ToolTip="How much the panel is asked to decode per second. The link carries far more than this; what runs out is the panel's own decoding, and it gives no sign when it falls behind. Raise it only while watching the panel.">
                        <ComboBoxItem><TextBlock Text="0.7 MB/s — for dense footage that still stutters" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="0.9 MB/s — softer, but steady" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="1.1 MB/s — what the panel has always been sent" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="1.4 MB/s — sharper; watch for stutter" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="1.9 MB/s — only if it keeps up" Foreground="#1A1207"/></ComboBoxItem>
                    </ComboBox>
                </Grid>

                <TextBlock x:Name="PreprocessHint" Margin="0,0,0,8" FontSize="11"
                           TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>

                <StackPanel x:Name="PackCachePanel" Orientation="Horizontal"
                            Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="PackCacheText" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource TextDim}"/>
                    <Button Content="Clear" Style="{StaticResource Btn}"
                            Margin="10,0,0,0" Click="OnClearPackCache"
                            ToolTip="Delete every preprocessed file. They rebuild the next time an item plays."/>
                </StackPanel>

                <TextBlock Text="STARTUP" Style="{StaticResource Heading}"/>

                <CheckBox x:Name="StartWithWindowsBox" Content="Start when I sign in"
                          Click="OnStartWithWindowsChanged"/>
                <TextBlock Margin="24,0,0,8" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Registers a scheduled task, which also restarts the app if it stops unexpectedly."/>

                <CheckBox x:Name="StartMinimisedBox" Content="Start hidden in the notification area"/>
                <CheckBox x:Name="ResumeBox" Content="Put back what was showing when I last quit"/>

                <CheckBox x:Name="StartAiBox" Content="Start the AI slideshow"/>
                <TextBlock x:Name="StartAiHint" Margin="24,0,0,8" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"/>

                <CheckBox x:Name="AutoReconnectBox" Content="Reconnect automatically when the display returns"/>
                <CheckBox x:Name="BlankOnExitBox" Content="Blank the panel on exit"/>
                <TextBlock Margin="24,0,0,14" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Off leaves the last frame frozen on the glass after the app closes."/>

                <TextBlock Text="SENSORS" Style="{StaticResource Heading}"/>

                <TextBlock Margin="0,0,0,8" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Windows cannot measure CPU temperature by itself — on AMD it sits behind the SMU and needs a kernel driver. Run either of these and the overlay can read what it already measures, along with fan speeds, coolant temperature and motherboard sensors."/>

                <CheckBox x:Name="LhmBox" Content="LibreHardwareMonitor"
                          Checked="OnSensorSourceChanged" Unchecked="OnSensorSourceChanged"/>
                <TextBlock Margin="24,0,0,8" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Needs its web server switched on: Options → Remote Web Server → Run."/>

                <CheckBox x:Name="HwInfoBox" Content="HWiNFO"
                          Checked="OnSensorSourceChanged" Unchecked="OnSensorSourceChanged"/>
                <TextBlock Margin="24,0,0,8" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Needs Shared Memory Support enabled in its settings."/>

                <TextBlock x:Name="SensorStatusText" TextWrapping="Wrap" FontSize="11"
                           Margin="0,2,0,14"/>

                <TextBlock Text="MUSIC" Style="{StaticResource Heading}"/>

                <TextBlock Margin="0,0,0,8" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Follows whatever is playing elsewhere on this machine — a browser tab, a music player — and puts it on the panel. Nothing here plays audio or controls playback; the player you already use stays the remote control."/>

                <CheckBox x:Name="MediaSessionBox" Content="Read what's playing"
                          Checked="OnMusicChanged" Unchecked="OnMusicChanged"/>
                <TextBlock Margin="24,0,0,8" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Publishes the track as music.* sensors, so any overlay can show the title, artist, album art or progress. Takes effect on the next restart."/>

                <CheckBox x:Name="MusicVideoBox" Content="Stream the music video"
                          Checked="OnMusicChanged" Unchecked="OnMusicChanged"/>
                <TextBlock Margin="24,0,0,8" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Searches YouTube for the track and streams the video live, matching on length so a lyric video or an hour-long loop is not mistaken for the song. Tracks with no video show the card instead. Off means the card, always, and no searching."/>

                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Follow" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <ComboBox Grid.Column="1" x:Name="MediaAppCombo"
                              SelectionChanged="OnMediaAppChanged"/>
                </Grid>
                <TextBlock Margin="24,0,0,14" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"
                           Text="Which player to follow when more than one is running. Automatic prefers whichever is actually playing."/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Keep videos" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <ComboBox Grid.Column="1" x:Name="MusicDaysCombo"
                              SelectionChanged="OnMusicCacheSettingChanged"
                              ToolTip="How long a downloaded video is kept after it was last played. Listening moves on, so this is what stops the cache filling with music you no longer play.">
                        <ComboBoxItem><TextBlock Text="3 days" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="1 week" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="2 weeks" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="1 month" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="3 months" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="Until the limit below is reached" Foreground="#1A1207"/></ComboBoxItem>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Cache limit" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <ComboBox Grid.Column="1" x:Name="MusicCacheCombo"
                              SelectionChanged="OnMusicCacheSettingChanged"
                              ToolTip="Reaching this drops the least recently played videos rather than refusing to fetch new ones. A 720p music video is usually 10-30 MB.">
                        <ComboBoxItem><TextBlock Text="512 MB" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="1 GB" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="2 GB" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="4 GB" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="8 GB" Foreground="#1A1207"/></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="16 GB" Foreground="#1A1207"/></ComboBoxItem>
                    </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
                    <TextBlock x:Name="MusicCacheText" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource TextDim}"/>
                    <Button Content="Clear" Style="{StaticResource Btn}"
                            Margin="10,0,0,0" Click="OnClearMusicCache"
                            ToolTip="Delete every downloaded music video. They are fetched again the next time each track plays."/>
                    <Button Content="Sweep now" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="OnSweepMusicCache"
                            ToolTip="Apply the two limits above straight away, rather than waiting for the hourly sweep."/>
                </StackPanel>

                <TextBlock Text="DEVICE" Style="{StaticResource Heading}"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Serial port" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}"/>
                    <TextBox x:Name="PortBox" Grid.Column="1"
                             ToolTip="Leave empty to find the display by its hardware ID."/>
                </Grid>

                <TextBlock x:Name="DeviceInfoText" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="Release device" Style="{StaticResource Btn}"
                            Click="OnReleaseDevice"
                            ToolTip="Hand the port back so the command-line tool can use it"/>
                    <Button Content="Open data folder" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="OnOpenFolder"/>
                </StackPanel>

                <TextBlock x:Name="FfmpegText" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource TextDim}"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Close" Style="{StaticResource BtnPrimary}" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
